{
  "name": "vue-fantasy-picker",
  "version": "0.1.0",
  "description": "A tool for evaluating the stats of fantasy sports players",
  "main": "client/index.js",
  "type": "module",
  "scripts": {
    "test": "testcafe all test/e2e/index.js --app \"npm run dev\" --app-init-delay 10000",
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "lint": "xo **/client/**/*.{vue,js} !node_modules/**"
  },
  "author": "Jon Campbell <lifeislearning@gmail.com>",
  "license": "MIT",
  "xo": {
    "extends": "./.eslintrc",
    "esnext": true,
    "envs": [
      "browser"
    ]
  },
  "babel": {
    "presets": [
      [
        "vue-app",
        {
          "useBuiltIns": true
        }
      ]
    ]
  },
  "browserslist": [
    "last 2 versions",
    "ie > 8"
  ],
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/vue-fontawesome": "^3.0.6",
    "babel-runtime": "^6.18.0",
    "papaparse": "^5.4.1",
    "promise-polyfill": "^6.1.0",
    "sweetalert2": "^11.12.4",
    "vue": "^3.4.21",
    "vue-router": "^4.3.2",
    "vuex": "^4.1.0",
    "vuex-persist": "^1.7.2"
  },
  "devDependencies": {
    "@babel/core": "^7.16.0",
    "@babel/eslint-parser": "^7.23.3",
    "@babel/preset-env": "^7.16.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/compiler-sfc": "^3.4.21",
    "@vue/test-utils": "^2.5.1",
    "eslint-config-vue": "latest",
    "eslint-plugin-testcafe": "^0.2.0",
    "eslint-plugin-vue": "latest",
    "happy-dom": "^20.14.6",
    "tailwindcss": "^4.3.3",
    "testcafe": "^0.12.1",
    "vite": "^5.4.0",
    "vitest": "^3.2.7",
    "xo": "^0.18.0"
  }
}
